# ─────────────────────────────────────────
# NexTrip Backend — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Never commit the actual .env file to version control.

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# Must start with "AIza..."
GOOGLE_API_KEY=AIzaSy_your_google_api_key_here

# RapidAPI Key (used for Flights, Trains, Buses, Hotels, Car Rentals)
# Get yours at: https://rapidapi.com/
RAPID_API_KEY=your_rapidapi_key_here

# WeatherStack API Key (used for Weather information)
# Get yours at: https://weatherstack.com/
WEATHER_STACK_API=your_weatherstack_api_key_here

